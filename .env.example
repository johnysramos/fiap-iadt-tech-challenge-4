# Copie este arquivo para .env e coloque a sua chave da OpenAI.
# Se a chave ja estiver definida como variavel de ambiente do sistema, pode deixar a linha comentada.
OPENAI_API_KEY=sk-...

# Modelo que transforma a fala em texto.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Modelo de texto e visao: analisa a transcricao, olha os frames dos eventos e escreve a conclusao do relatorio.
OPENAI_CHAT_MODEL=gpt-5.4-mini
